// Admin: scan attendance (QR), student QR cards, alumni approval, achievements
import { sb } from '../supabase.js';
import { CONFIG } from '../config.js';
import { must } from '../api.js';
import { crudPage } from '../crud.js';
import { $, $$, esc, icon, toast, fail, confirmBox, setBusy, badge, tableHtml, emptyState, loadingBlock, fmtDate, fmtDateTime } from '../ui.js';

/* ================= Scan attendance (QR) ================= */
export function scanAttendance() {
  return async (view) => {
    view.innerHTML = `<div class="page-head"><div><h2>Scan attendance</h2><p class="muted">Point the camera at a student's card, or type the code. The student is marked present (late after 08:30) and the parent is notified.</p></div></div>
      <div class="card" style="margin-bottom:16px">
        <video id="sc-video" playsinline muted style="width:100%;max-width:420px;border-radius:12px;background:#000;display:none"></video>
        <p id="sc-hint" class="muted" style="margin:8px 0"></p>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button class="btn primary" id="sc-start" type="button">${icon('eye', 16)} Start camera</button>
          <button class="btn ghost" id="sc-stop" type="button" hidden>Stop camera</button>
        </div>
        <form id="sc-form" style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap" novalidate>
          <input class="input" id="sc-code" placeholder="Card code (a scanner or keyboard works here)" autocomplete="off" style="flex:1;min-width:220px">
          <button class="btn ghost" type="submit">Mark attendance</button>
        </form>
      </div>
      <div class="card" id="sc-result" hidden></div>
      <div class="card flush" style="margin-top:16px"><div class="pad"><b>Scanned in this session</b></div><div id="sc-recent">${emptyState('Nothing scanned yet', 'Scans will be listed here.', 'calendar')}</div></div>`;

    const video = $('#sc-video', view), hint = $('#sc-hint', view), result = $('#sc-result', view);
    const recent = []; let stream = null, timer = null, busy = false, last = { code: '', at: 0 };

    const stop = () => {
      if (timer) clearInterval(timer); timer = null;
      if (stream) stream.getTracks().forEach((t) => t.stop()); stream = null;
      video.style.display = 'none'; $('#sc-stop', view).hidden = true; $('#sc-start', view).hidden = false;
    };
    addEventListener('hashchange', stop, { once: true });

    const draw = () => {
      $('#sc-recent', view).innerHTML = tableHtml({
        columns: [
          { label: 'Time', render: (r) => esc(r.time) },
          { label: 'Student', render: (r) => `<b>${esc(r.name)}</b><span class="sub">${esc(r.no)}</span>` },
          { label: 'Result', render: (r) => (r.error ? badge('error', 'bad') : badge(r.already ? `already ${r.status}` : r.status, r.already ? 'muted' : r.status === 'late' ? 'warn' : 'ok')) },
        ], rows: recent,
      });
    };

    async function handle(raw) {
      const code = String(raw || '').trim();
      if (!code || busy) return;
      if (code === last.code && Date.now() - last.at < 4000) return;
      last = { code, at: Date.now() }; busy = true;
      const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      try {
        const { data, error } = await sb.rpc('scan_attendance', { p_token: code });
        if (error) throw error;
        const r = data?.[0]; if (!r) throw new Error('No result');
        navigator.vibrate?.(120);
        result.hidden = false;
        result.innerHTML = `<div class="state"><span class="badge ${r.o_already ? 'muted' : r.o_status === 'late' ? 'warn' : 'ok'}">${r.o_already ? 'Already marked: ' + esc(r.o_status) : esc(r.o_status)}</span><h4>${esc(r.o_name)}</h4><p class="muted">${esc(r.o_student_no)}${r.o_already ? '' : '. The parent has been notified.'}</p></div>`;
        recent.unshift({ time, name: r.o_name, no: r.o_student_no, status: r.o_status, already: r.o_already });
      } catch (err) {
        result.hidden = false;
        result.innerHTML = `<div class="state"><span class="badge bad">Not marked</span><h4>${esc(err.message || 'Scan failed')}</h4></div>`;
        recent.unshift({ time, name: 'Unknown card', no: '', error: true });
      } finally { busy = false; draw(); }
    }

    $('#sc-form', view).onsubmit = (e) => { e.preventDefault(); const i = $('#sc-code', view); handle(i.value); i.value = ''; i.focus(); };
    $('#sc-start', view).onclick = async () => {
      try {
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
        video.srcObject = stream; video.style.display = 'block'; await video.play();
        $('#sc-stop', view).hidden = false; $('#sc-start', view).hidden = true;
        if (!('BarcodeDetector' in window)) { hint.textContent = 'This browser cannot read QR codes from the camera. Use Chrome on Android, or type or scan the code in the box below.'; return; }
        hint.textContent = 'Hold the card in front of the camera.';
        const det = new BarcodeDetector({ formats: ['qr_code'] });
        timer = setInterval(async () => {
          if (!view.isConnected) return stop();
          try { const c = await det.detect(video); if (c[0]) handle(c[0].rawValue); } catch { /* ignore frame errors */ }
        }, 400);
      } catch (err) { stop(); hint.textContent = 'The camera could not be opened. Allow camera access, or type the card code below.'; fail(err); }
    };
    $('#sc-stop', view).onclick = stop;
  };
}

/* ================= Student QR cards ================= */
let qrLib = null;
const loadQr = () => qrLib ||= new Promise((res, rej) => {
  if (window.QRCode) return res();
  const s = document.createElement('script');
  s.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
  s.onload = () => res(); s.onerror = () => rej(new Error('Could not load the QR code tool. Check your internet connection.'));
  document.head.appendChild(s);
});
const qrUrl = (text) => { const d = document.createElement('div'); new window.QRCode(d, { text, width: 220, height: 220, correctLevel: window.QRCode.CorrectLevel.M }); return d.querySelector('canvas').toDataURL('image/png'); };

export function studentCards() {
  return async (view) => {
    const classes = await must(sb.from('classes').select('id,name').order('name'));
    view.innerHTML = `<div class="page-head"><div><h2>Student cards</h2><p class="muted">Each card has a QR code. Print the cards and give them to students to scan at the gate.</p></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap"><select class="input" id="sc-class" aria-label="Class"><option value="">All classes</option>${classes.map((c) => `<option value="${c.id}">${esc(c.name)}</option>`).join('')}</select>
      <button class="btn primary" id="sc-print" type="button">${icon('file', 16)} Print cards</button></div></div>
      <div id="sc-cards">${loadingBlock()}</div>`;
    let rows = [];
    async function load() {
      let q = sb.from('students').select('id,full_name,student_no,qr_token,classes(name)').eq('status', 'active').order('full_name').limit(1000);
      const c = $('#sc-class', view).value; if (c) q = q.eq('class_id', c);
      rows = (await must(q)).filter((r) => r.qr_token);
      await loadQr();
      $('#sc-cards', view).innerHTML = rows.length
        ? `<div class="thumb-grid">${rows.map((r) => `<figure class="thumb" style="margin:0;padding:12px;text-align:center"><img src="${qrUrl(r.qr_token)}" alt="QR code for ${esc(r.full_name)}" style="max-width:150px"><figcaption style="display:block"><b>${esc(r.full_name)}</b><br><span class="muted">${esc(r.student_no)} | ${esc(r.classes?.name || 'No class')}</span></figcaption></figure>`).join('')}</div>`
        : emptyState('No students yet', 'Add students first. Each one gets a QR card automatically.', 'student');
    }
    $('#sc-class', view).onchange = () => load().catch(fail);
    $('#sc-print', view).onclick = () => {
      if (!rows.length) return toast('There are no cards to print', 'info');
      const logo = new URL('assets/logo.svg', location.href).href;
      const cards = rows.map((r) => `<div class="card"><div class="top"><img src="${logo}" alt=""><b>${esc(CONFIG.SCHOOL.name)}</b></div><img class="qr" src="${qrUrl(r.qr_token)}" alt=""><div class="nm">${esc(r.full_name)}</div><div class="no">${esc(r.student_no)} | ${esc(r.classes?.name || '')}</div></div>`).join('');
      const w = window.open('', '_blank');
      if (!w) return toast('Allow pop-ups to print the cards', 'error');
      w.document.write(`<!doctype html><title>Student cards</title><style>body{font-family:Arial,sans-serif;margin:12px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.card{border:2px solid #14307f;border-radius:10px;padding:10px;text-align:center;break-inside:avoid}.top{display:flex;align-items:center;gap:6px;justify-content:center;font-size:11px;color:#14307f}.top img{height:28px}.qr{width:130px;height:130px;margin:8px 0}.nm{font-weight:700;font-size:14px}.no{font-size:12px;color:#444}@media print{body{margin:0}}</style><div class="grid">${cards}</div>`);
      w.document.close(); setTimeout(() => w.print(), 600);
    };
    await load().catch((e) => { fail(e); $('#sc-cards', view).innerHTML = emptyState('Could not load cards', 'Try again.', 'alert'); });
  };
}

/* ================= Alumni ================= */
export function alumni() {
  return crudPage({
    table: 'alumni', title: 'Alumni', singular: 'alumnus', plural: 'alumni', description: 'Former students who registered on the website. Approve a person to show their name on the public Alumni section. Phone and email are never shown publicly.',
    order: { col: 'created_at', asc: false }, search: ['full_name', 'email', 'current_work'], searchPlaceholder: 'Search name, email or work',
    canCreate: false, canEdit: false, canDelete: true, exportName: 'Alumni',
    filters: [{ name: 'status', label: 'All statuses', options: ['pending', 'approved', 'rejected'].map((v) => ({ value: v, label: v })) }],
    columns: [
      { label: 'Name', render: (r) => `<b>${esc(r.full_name)}</b><span class="sub">${r.graduation_year ? 'Class of ' + esc(String(r.graduation_year)) : ''}</span>` },
      { label: 'Work', render: (r) => esc(r.current_work || '') },
      { label: 'Contact', render: (r) => `${esc(r.phone || '')}<span class="sub">${esc(r.email || '')}</span>` },
      { label: 'Status', render: (r) => badge(r.status, { approved: 'ok', pending: 'warn', rejected: 'bad' }[r.status] || 'muted') },
      { label: 'Registered', render: (r) => fmtDate(r.created_at) },
    ],
    exportMap: (r) => ({ Name: r.full_name, Year: r.graduation_year || '', Work: r.current_work || '', Phone: r.phone || '', Email: r.email || '', Status: r.status }),
    rowActions: (r) => `<button class="icon-btn" data-act="view" data-id="${r.id}" title="Read message" aria-label="Read message">${icon('eye', 16)}</button>
      ${r.status !== 'approved' ? `<button class="icon-btn" data-act="approve" data-id="${r.id}" title="Approve" aria-label="Approve">${icon('check', 16)}</button>` : ''}
      ${r.status !== 'rejected' ? `<button class="icon-btn danger" data-act="reject" data-id="${r.id}" title="Reject" aria-label="Reject">${icon('lock', 16)}</button>` : ''}`,
    onAction: async (act, row, { reload }) => {
      if (act === 'view') {
        const { modal } = await import('../ui.js');
        return modal({ title: row.full_name, html: `<p class="muted">${row.graduation_year ? 'Class of ' + esc(String(row.graduation_year)) + '. ' : ''}${esc(row.current_work || '')}</p><p style="white-space:pre-wrap;margin-top:12px">${esc(row.message || '(no message)')}</p><p class="muted" style="margin-top:12px">${esc(row.phone || '')} ${esc(row.email || '')}</p>` });
      }
      const status = act === 'approve' ? 'approved' : 'rejected';
      try { await must(sb.from('alumni').update({ status }).eq('id', row.id)); toast(status === 'approved' ? 'Approved. Now shown on the website.' : 'Rejected'); reload(); } catch (e) { fail(e); }
    },
  });
}

/* ================= Achievements ================= */
const CATS = [['award', 'Award'], ['exam_result', 'Exam result'], ['sports', 'Sports'], ['competition', 'Competition'], ['other', 'Other']];
export function achievements() {
  return async (view) => {
    const url = (p) => sb.storage.from('gallery').getPublicUrl(p).data.publicUrl;
    view.innerHTML = `<div class="page-head"><div><h2>Achievements</h2><p class="muted">Prizes, exam results and awards shown on the public website. A photo is optional (JPG, PNG or WebP, up to 5 MB).</p></div></div>
      <div class="card" style="margin-bottom:16px"><form id="ac-form" class="form-grid" novalidate>
        <div class="field full"><label for="ac-title">Title <i class="req">*</i></label><input class="input" id="ac-title" name="title" maxlength="150" required placeholder="e.g. 100% pass rate in BECE 2026"><small class="err" data-err="title"></small></div>
        <div class="field"><label for="ac-cat">Type</label><select class="input" id="ac-cat" name="category">${CATS.map(([v, l]) => `<option value="${v}">${l}</option>`).join('')}</select></div>
        <div class="field"><label for="ac-date">Date</label><input class="input" id="ac-date" name="achieved_on" type="date"></div>
        <div class="field full"><label for="ac-desc">Details</label><textarea class="input" id="ac-desc" name="description" rows="3" maxlength="2000"></textarea></div>
        <div class="field full"><label for="ac-file">Photo (optional)</label><input class="input" id="ac-file" name="file" type="file" accept="image/jpeg,image/png,image/webp"><small class="err" data-err="file"></small></div>
        <div class="field full"><button class="btn primary" id="ac-add" type="submit" style="width:fit-content">${icon('plus', 16)} Add achievement</button></div></form></div>
      <div class="card flush" id="ac-list">${loadingBlock()}</div>`;
    const listEl = $('#ac-list', view);
    async function load() {
      const rows = await must(sb.from('achievements').select('*').order('created_at', { ascending: false }).limit(300));
      listEl.innerHTML = rows.length ? tableHtml({
        columns: [
          { label: 'Achievement', render: (r) => `<b>${esc(r.title)}</b><span class="sub">${esc((CATS.find((c) => c[0] === r.category) || [])[1] || '')}${r.achieved_on ? ' | ' + esc(fmtDate(r.achieved_on)) : ''}</span>` },
          { label: 'Photo', render: (r) => (r.image_path ? `<img src="${esc(url(r.image_path))}" alt="" style="height:40px;border-radius:6px">` : '') },
          { label: 'Website', render: (r) => badge(r.is_published ? 'shown' : 'hidden', r.is_published ? 'ok' : 'muted') },
          { label: '', cls: 'actions', render: (r) => `<button class="icon-btn" data-tog="${r.id}" title="${r.is_published ? 'Hide' : 'Show'}" aria-label="${r.is_published ? 'Hide' : 'Show'}">${icon('eye', 16)}</button><button class="icon-btn danger" data-del="${r.id}" aria-label="Delete">${icon('trash', 16)}</button>` },
        ], rows,
      }) : emptyState('No achievements yet', 'Add the first one using the form above.', 'chart');
      listEl.onclick = async (e) => {
        const t = e.target.closest('[data-tog]'), d = e.target.closest('[data-del]');
        if (t) { const row = rows.find((r) => r.id === t.dataset.tog); try { await must(sb.from('achievements').update({ is_published: !row.is_published }).eq('id', row.id)); load(); } catch (err) { fail(err); } }
        if (d) {
          const row = rows.find((r) => r.id === d.dataset.del);
          if (!(await confirmBox({ title: 'Delete achievement?', message: 'It will disappear from the website.', confirmText: 'Delete', danger: true }))) return;
          try { if (row.image_path) await sb.storage.from('gallery').remove([row.image_path]); await must(sb.from('achievements').delete().eq('id', row.id)); toast('Deleted'); load(); } catch (err) { fail(err); }
        }
      };
    }
    $('#ac-form', view).onsubmit = async (e) => {
      e.preventDefault();
      const f = e.target, title = f.title.value.trim(), file = f.file.files[0];
      $$('[data-err]', f).forEach((x) => (x.textContent = ''));
      if (title.length < 3) return ($('[data-err=title]', f).textContent = 'Enter a title (at least 3 letters)');
      if (file && !['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) return ($('[data-err=file]', f).textContent = 'Use a JPG, PNG or WebP image');
      if (file && file.size > 5 * 1024 * 1024) return ($('[data-err=file]', f).textContent = 'The photo is larger than 5 MB');
      const btn = $('#ac-add', view); setBusy(btn, true, 'Saving');
      try {
        let image_path = null;
        if (file) {
          image_path = `achievements/${crypto.randomUUID()}.${file.type === 'image/png' ? 'png' : file.type === 'image/webp' ? 'webp' : 'jpg'}`;
          const { error } = await sb.storage.from('gallery').upload(image_path, file, { contentType: file.type, cacheControl: '31536000' });
          if (error) throw error;
        }
        await must(sb.from('achievements').insert({ title, category: f.category.value, achieved_on: f.achieved_on.value || null, description: f.description.value.trim() || null, image_path }));
        f.reset(); toast('Achievement added'); load();
      } catch (err) { fail(err); } finally { setBusy(btn, false); }
    };
    await load();
  };
}
