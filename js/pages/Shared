/* =========================================================
   STUDENT-FACING VIEWS (student portal + parent portal)
   ========================================================= */
export async function attendanceView(view, studentId) {
  view.innerHTML = loadingBlock();
  const rows = await must(sb.from('attendance').select('attendance_date,status,note').eq('student_id', studentId).order('attendance_date', { ascending: false }).limit(400));
  if (!rows.length) { view.innerHTML = emptyState('No attendance records yet', 'Records appear here once your teacher starts taking attendance.', 'calendar'); return; }
  const c = { present: 0, absent: 0, late: 0 }; rows.forEach((r) => c[r.status]++);
  const rate = Math.round(((c.present + c.late) / rows.length) * 100);
  view.innerHTML = `
    <div class="stats">
      <div class="stat ok"><span class="ico">${icon('check')}</span><div><b>${rate}%</b><span>Attendance rate</span></div></div>
      <div class="stat ok"><span class="ico">${icon('calendar')}</span><div><b>${c.present}</b><span>Days present</span></div></div>
      <div class="stat bad"><span class="ico">${icon('x')}</span><div><b>${c.absent}</b><span>Days absent</span></div></div>
      <div class="stat gold"><span class="ico">${icon('clock')}</span><div><b>${c.late}</b><span>Days late</span></div></div>
    </div>
    <div class="card flush">${tableHtml({ columns: [
      { label: 'Date', render: (r) => fmtDate(r.attendance_date) }, { label: 'Status', render: (r) => badge(r.status) }, { label: 'Note', render: (r) => esc(r.note || '') }], rows: rows.slice(0, 120) })}</div>`;
}

export async function resultsView(view, studentId) {
  view.innerHTML = loadingBlock();
  const [student, rows] = await Promise.all([
    must(sb.from('students').select('id,full_name,student_no,classes(name)').eq('id', studentId).single()),
    must(sb.from('exam_results').select('exam_id,score,grade,remarks,subjects(name),examinations(id,name,term,max_score,class_id,published_at,academic_years(name),classes(name))').eq('student_id', studentId).limit(2000)),
  ]);
  if (!rows.length) { view.innerHTML = emptyState('No published results yet', 'Results appear here as soon as the school publishes them.', 'file'); return; }
  const groups = {};
  rows.forEach((r) => { (groups[r.exam_id] ||= { exam: r.examinations, rows: [] }).rows.push(r); });
  const list = Object.values(groups).sort((a, b) => String(b.exam.published_at).localeCompare(String(a.exam.published_at)));
  view.innerHTML = list.map((g, i) => {
    const total = g.rows.reduce((a, r) => a + Number(r.score), 0), max = g.rows.length * Number(g.exam.max_score);
    const avg = max ? (total / max) * 100 : 0;
    return `<div class="card" style="margin-bottom:16px"><div class="card-head"><div><h3>${esc(g.exam.name)}</h3><small class="muted">${esc(g.exam.term)} | ${esc(g.exam.academic_years?.name || '')} | ${esc(g.exam.classes?.name || '')}</small></div>
      <div class="head-actions"><span class="badge info">Average ${num(avg)}% | Grade ${gradeFor(avg).grade}</span><button class="btn ghost sm" data-card="${i}">${icon('printer', 15)} Report card</button></div></div>
      ${tableHtml({ columns: [{ label: 'Subject', render: (r) => esc(r.subjects?.name) }, { label: 'Score', cls: 'num', render: (r) => `${num(r.score, 2)} / ${num(g.exam.max_score)}` }, { label: 'Grade', render: (r) => badge(r.grade, 'info') }, { label: 'Remarks', render: (r) => esc(r.remarks || '') }], rows: g.rows.sort((a, b) => String(a.subjects?.name).localeCompare(String(b.subjects?.name))) })}</div>`;
  }).join('');
  view.addEventListener('click', (e) => {
    const b = e.target.closest('[data-card]'); if (!b) return;
    const g = list[Number(b.dataset.card)];
    showPrintable('Report card', reportCardHtml({
      student: { full_name: student.full_name, student_no: student.student_no }, className: g.exam.classes?.name, exam: g.exam, yearName: g.exam.academic_years?.name,
      rows: g.rows.map((r) => ({ subject: r.subjects?.name, score: r.score, max: g.exam.max_score, grade: r.grade, remarks: r.remarks })).sort((a, b2) => String(a.subject).localeCompare(String(b2.subject))),
    }));
  });
}

export async function feesView(view, studentId, ctx = null) {
  view.innerHTML = loadingBlock();
  const [bal, student, pays, claims] = await Promise.all([
    must(sb.from('student_fee_balances').select('*').eq('student_id', studentId).maybeSingle()),
    must(sb.from('students').select('id,full_name,student_no,class_id,classes(name)').eq('id', studentId).single()),
    must(sb.from('fee_payments').select('*, school_fees(name,term)').eq('student_id', studentId).order('paid_on', { ascending: false }).limit(200)),
    ctx ? must(sb.from('payment_claims').select('*').eq('student_id', studentId).order('created_at', { ascending: false }).limit(30)) : [],
  ]);
  const fees = student.class_id ? await must(sb.from('school_fees').select('*').eq('class_id', student.class_id).order('due_date')) : [];
  const total = Number(bal?.total_fees || 0), paid = Number(bal?.total_paid || 0), due = Number(bal?.balance || 0);
  const share = total ? Math.min(100, Math.round((paid / total) * 100)) : 0;
  const claimsHtml = ctx ? `<div class="card flush" style="margin-top:16px"><div class="card-head pad"><div><h3>Payments you reported</h3><small class="muted">Paid by mobile money or bank transfer? Report it here and the school will confirm it.</small></div><button class="btn primary sm" id="fv-report">${icon('plus', 15)} Report a payment</button></div>
      ${claims.length ? tableHtml({ columns: [{ label: 'Date', render: (c) => fmtDate(c.paid_on) }, { label: 'Reference', render: (c) => esc(c.reference) }, { label: 'Amount', cls: 'num', render: (c) => fmtMoney(c.amount) }, { label: 'Status', render: (c) => badge(c.status, c.status === 'approved' ? 'ok' : c.status === 'rejected' ? 'bad' : 'warn') + (c.review_note ? `<span class="sub">${esc(c.review_note)}</span>` : '') }], rows: claims }) : ''}</div>` : '';
  view.innerHTML = `
    <div class="stats">
      <div class="stat"><span class="ico">${icon('wallet')}</span><div><b>${fmtMoney(total)}</b><span>Total fees</span></div></div>
      <div class="stat ok"><span class="ico">${icon('check')}</span><div><b>${fmtMoney(paid)}</b><span>Paid</span></div></div>
      <div class="stat ${due > 0 ? 'bad' : 'ok'}"><span class="ico">${icon('alert')}</span><div><b>${fmtMoney(Math.max(due, 0))}</b><span>Outstanding</span></div></div>
    </div>
    <div class="card" style="margin-bottom:16px"><div class="card-head"><h3>Payment progress</h3><span class="muted">${share}% paid</span></div><div class="bar ${due > 0 ? 'warn' : ''}"><i style="width:${share}%"></i></div></div>
    <div class="grid cols-2">
      <div class="card flush"><div class="pad"><h3>Fee structure</h3></div>${tableHtml({ columns: [{ label: 'Fee', render: (f) => `${esc(f.name)}<span class="sub">${esc(f.term)}</span>` }, { label: 'Due', render: (f) => fmtDate(f.due_date) }, { label: 'Amount', cls: 'num', render: (f) => fmtMoney(f.amount) }], rows: fees, empty: 'No fees set for this class yet' })}</div>
      <div class="card flush"><div class="pad"><h3>Payment history</h3></div>${tableHtml({ columns: [{ label: 'Receipt', render: (p) => esc(p.receipt_no) }, { label: 'Date', render: (p) => fmtDate(p.paid_on) }, { label: 'Amount', cls: 'num', render: (p) => fmtMoney(p.amount) }, { label: '', cls: 'actions', render: (p) => `<button class="icon-btn" data-rc="${p.id}" title="View receipt" aria-label="View receipt">${icon('receipt', 16)}</button>` }], rows: pays, empty: 'No payments recorded yet' })}</div>
    </div>${claimsHtml}`;
  $('#fv-report', view)?.addEventListener('click', () => reportPayment(student, fees, ctx, () => feesView(view, studentId, ctx)));
  view.addEventListener('click', (e) => {
    const b = e.target.closest('[data-rc]'); if (!b) return;
    const p = pays.find((x) => x.id === b.dataset.rc);
    showPrintable('Payment receipt', receiptHtml(p, student, student.classes?.name, due));
  });
}

export async function announcementsView(view) {
  view.innerHTML = loadingBlock();
  const rows = await must(sb.from('announcements').select('*').eq('published', true).order('created_at', { ascending: false }).limit(60));
  if (!rows.length) { view.innerHTML = emptyState('No announcements yet', 'School news and notices will appear here.', 'megaphone'); return; }
  view.innerHTML = `<div class="grid">${rows.map((a) => `<article class="card"><div class="card-head"><h3>${esc(a.title)}</h3>${badge(a.kind, a.kind === 'event' ? 'info' : 'muted')}</div>
    <p style="white-space:pre-wrap">${esc(a.body)}</p><small class="muted">${a.event_date ? `Event date: ${fmtDate(a.event_date)} | ` : ''}Posted ${fmtDateTime(a.created_at)}</small></article>`).join('')}</div>`;
}

export async function profileView(view, ctx) {
  const p = ctx.profile;
  view.innerHTML = `<div class="grid cols-2">
    <div class="card"><h3>My details</h3>
      ${formHtml([{ name: 'full_name', label: 'Full name', required: true, full: true }, { name: 'phone', label: 'Phone', type: 'tel', full: true }, { name: 'email', label: 'Email (sign-in)', readonly: true, full: true }, { name: 'role', label: 'Role', readonly: true, full: true }], { ...p, role: ROLE_LABEL[p.role] })}
      <p style="margin-top:14px"><button class="btn primary" id="pf-save">Save changes</button></p></div>
    <div class="card"><h3>Change password</h3>
      ${formHtml([{ name: 'current', label: 'Current password', type: 'password', required: true, full: true }, { name: 'password', label: 'New password', type: 'password', required: true, minlength: 8, full: true, help: 'At least 8 characters.' }, { name: 'confirm', label: 'Confirm new password', type: 'password', required: true, full: true }])}
      <p style="margin-top:14px"><button class="btn primary" id="pw-save">Update password</button></p></div></div>`;
  const [f1, f2] = $$('form', view);
  const fields1 = [{ name: 'full_name', label: 'Full name', required: true }, { name: 'phone', label: 'Phone', type: 'tel' }];
  const fields2 = [{ name: 'current', label: 'Current password', type: 'password', required: true }, { name: 'password', label: 'New password', type: 'password', required: true, minlength: 8 }, { name: 'confirm', label: 'Confirm', type: 'password', required: true }];
  $('#pf-save', view).onclick = async (e) => {
    const { ok, values } = readForm(f1, fields1); if (!ok) return;
    setBusy(e.currentTarget, true, 'Saving');
    try { await must(sb.from('profiles').update(values).eq('id', p.id)); Object.assign(p, values); toast('Profile updated'); } catch (err) { fail(err); } finally { setBusy(e.currentTarget, false); }
  };
  $('#pw-save', view).onclick = async (e) => {
    const { ok, values } = readForm(f2, fields2); if (!ok) return;
    if (values.password !== values.confirm) return toast('The two passwords do not match', 'error');
    setBusy(e.currentTarget, true, 'Updating');
    try { const { error } = await sb.auth.updateUser({ password: values.password, current_password: values.current }); if (error) throw error; f2.reset(); toast('Password updated'); } catch (err) { fail(err); } finally { setBusy(e.currentTarget, false); }
  };
}

