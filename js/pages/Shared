/* A family reports a payment made outside the school (mobile money, bank). The office verifies it. */
function reportPayment(student, fees, ctx, done) {
  const fields = [
    { name: 'fee_id', label: 'Fee paid for', type: 'select', blank: 'General payment', full: true, options: fees.map((f) => ({ value: f.id, label: `${f.name} (${f.term}) - ${fmtMoney(f.amount)}` })) },
    { name: 'amount', label: 'Amount paid', type: 'number', required: true, min: 0.01, step: '0.01' },
    { name: 'method', label: 'How you paid', type: 'select', required: true, options: [{ value: 'mobile_money', label: 'Mobile money' }, { value: 'bank_transfer', label: 'Bank transfer' }, { value: 'cash', label: 'Cash deposit' }] },
    { name: 'reference', label: 'Transaction ID / reference', required: true, maxlength: 80, help: 'The code in your payment confirmation message.' },
    { name: 'paid_on', label: 'Date paid', type: 'date', required: true, max: today() },
    { name: 'note', label: 'Note (optional)', type: 'textarea', rows: 2, full: true, maxlength: 500 },
  ];
  const m = modal({ title: `Report a payment for ${student.full_name}`, size: 'md',
    html: `${formHtml(fields, { method: 'mobile_money', paid_on: today() })}<div class="field" style="margin-top:12px"><label for="rp-proof">Screenshot or receipt (optional)</label><input id="rp-proof" class="input" type="file" accept="application/pdf,image/jpeg,image/png"><small class="help">PDF, JPG or PNG up to 5 MB.</small></div>`,
    footer: `<button class="btn ghost" data-close>Cancel</button><button class="btn primary" id="rp-send">Send to the school</button>` });
  $('#rp-send', m.el).onclick = async (e) => {
    const { ok, values } = readForm($('form', m.el), fields); if (!ok) return;
    const file = $('#rp-proof', m.el).files[0];
    if (file && (file.size > 5 * 1024 * 1024 || !/^(application\/pdf|image\/(jpeg|png))$/.test(file.type))) return toast('The proof must be a PDF, JPG or PNG up to 5 MB', 'error');
    setBusy(e.currentTarget, true, 'Sending');
    try {
      let proof_path = null;
      if (file) {
        proof_path = `${ctx.user.id}/${Date.now()}-${file.name.replace(/[^a-zA-Z0-9._-]/g, '_').slice(-60)}`;
        const { error } = await sb.storage.from('payment-proofs').upload(proof_path, file, { contentType: file.type });
        if (error) throw error;
      }
      await must(sb.from('payment_claims').insert({ ...values, student_id: student.id, submitted_by: ctx.user.id, proof_path }).select('id'));
      toast('Sent. The school will confirm your payment shortly.'); m.close(); done();
    } catch (err) { fail(err); setBusy(e.currentTarget, false); }
  };
}
