// Views reused across portals
import { sb } from '../supabase.js';
import { CONFIG } from '../config.js';
import { must, pct, notifyUsers, callFunction } from '../api.js';
import {
  $, $$, esc, icon, LOGO, toast, fail, modal, setBusy, badge, tableHtml, emptyState, loadingBlock, errorBlock,
  fmtDate, fmtDateTime, fmtMoney, num, today, gradeFor, formHtml, readForm, initials,
} from '../ui.js';
