const opt = (rows, v, l) => rows.map((r) => `<option value="${esc(r[v])}">${esc(typeof l === 'function' ? l(r) : r[l])}</option>`).join('');

/* =========================================================
   ATTENDANCE - take / edit for one class and date
   ========================================================= */
export async function attendanceTaker(view, ctx, { classOptions }) {
  const classes = await classOptions();
  if (!classes.length) { view.innerHTML = emptyState('No classes available', 'You have not been assigned to any class yet.', 'class'); return; }
  view.innerHTML = `
    <div class="page-head"><div><h2>Take attendance</h2><p class="muted">Mark each student present, absent or late, then save. Parents of absent students are notified.</p></div></div>
    <div class="toolbar">
      <select id="at-class" class="input sm" aria-label="Class">${opt(classes, 'value', 'label')}</select>
      <input type="date" id="at-date" class="input sm" value="${today()}" max="${today()}" aria-label="Date">
      <button class="btn ghost sm" id="at-all">Mark all present</button>
    </div>
    <div class="card flush"><div id="at-body"></div></div>
    <div class="pager"><span id="at-sum" class="muted"></span><button class="btn primary" id="at-save">Save attendance</button></div>`;
  const body = $('#at-body', view), sum = $('#at-sum', view), save = $('#at-save', view);
  let students = [];

  const updateSum = () => {
    const c = { present: 0, absent: 0, late: 0 };
    $$('input[type=radio]:checked', body).forEach((r) => c[r.value]++);
    sum.textContent = `${c.present} present, ${c.absent} absent, ${c.late} late of ${students.length}`;
  };

  async function load() {
    body.innerHTML = loadingBlock();
    try {
      const classId = $('#at-class', view).value, date = $('#at-date', view).value;
      students = await must(sb.from('students').select('id,full_name,student_no').eq('class_id', classId).eq('status', 'active').order('full_name').limit(500));
      const existing = students.length ? await must(sb.from('attendance').select('student_id,status,note').eq('class_id', classId).eq('attendance_date', date)) : [];
      const by = Object.fromEntries(existing.map((a) => [a.student_id, a]));
      if (!students.length) { body.innerHTML = emptyState('No students in this class', 'Assign students to the class first.', 'users'); sum.textContent = ''; save.disabled = true; return; }
      save.disabled = false;
      body.innerHTML = `<div class="table-wrap"><table class="table"><thead><tr><th>Student</th><th>Status</th><th>Note</th></tr></thead><tbody>${students.map((s) => {
        const st = by[s.id]?.status || 'present';
        return `<tr data-id="${s.id}"><td><b>${esc(s.full_name)}</b><span class="sub">${esc(s.student_no)}</span></td>
          <td><div class="seg" role="radiogroup" aria-label="Status for ${esc(s.full_name)}">
            ${[['present', 'P', 'p'], ['absent', 'A', 'a'], ['late', 'L', 'l']].map(([v, t, k]) => `<label><input type="radio" name="s_${s.id}" value="${v}" ${st === v ? 'checked' : ''}><span class="${k}" title="${v}">${t}</span></label>`).join('')}
          </div></td>
          <td><input class="input" name="n_${s.id}" maxlength="120" value="${esc(by[s.id]?.note || '')}" placeholder="Optional note"></td></tr>`;
      }).join('')}</tbody></table></div>`;
      updateSum();
    } catch (e) { body.innerHTML = errorBlock(e); $('[data-retry]', body)?.addEventListener('click', load); }
  }
  body.addEventListener('change', updateSum);
  $('#at-class', view).onchange = load; $('#at-date', view).onchange = load;
  $('#at-all', view).onclick = () => { $$('input[value=present]', body).forEach((r) => (r.checked = true)); updateSum(); };
  save.onclick = async () => {
    if (!students.length) return;
    const classId = $('#at-class', view).value, date = $('#at-date', view).value;
    if (!date) return toast('Choose a date', 'error');
    const rows = students.map((s) => ({
      student_id: s.id, class_id: classId, attendance_date: date, marked_by: ctx.user.id,
      status: $(`input[name="s_${s.id}"]:checked`, body)?.value || 'present',
      note: ($(`input[name="n_${s.id}"]`, body)?.value || '').trim() || null,
    }));
    setBusy(save, true, 'Saving');
    try {
      await must(sb.from('attendance').upsert(rows, { onConflict: 'student_id,attendance_date' }));
      let msg = 'Attendance saved';
      if (rows.some((r) => r.status === 'absent')) {
        const { data, error } = await sb.rpc('notify_absent', { p_class: classId, p_date: date });
        const ids = Array.isArray(data) ? data : [];
        if (!error && ids.length) {
          msg += `, ${ids.length} parent${ids.length === 1 ? '' : 's'} notified`;
          if (CONFIG.EXTERNAL_NOTIFICATIONS) callFunction('notify-external', { user_ids: ids, title: 'Absence alert', body: `Your child was marked absent on ${date}.` }).catch((e2) => console.warn('External notification failed', e2));
        }
      }
      toast(msg);
    } catch (e) { fail(e); } finally { setBusy(save, false); }
  };
  await load();
}

/* =========================================================
   SCORE ENTRY - per exam and subject
   ========================================================= */
export async function scoreEntry(view, ctx, { teacherId = null, isAdmin = false } = {}) {
  const exams = await must(sb.from('examinations').select('*, classes(name)').order('created_at', { ascending: false }).limit(300));
  if (!exams.length) { view.innerHTML = emptyState('No examinations yet', isAdmin ? 'Create an examination first, then enter scores here.' : 'No examinations exist for your classes yet.', 'file'); return; }
  view.innerHTML = `
    <div class="page-head"><div><h2>Enter scores</h2><p class="muted">Grades are calculated automatically from the percentage.</p></div></div>
    <div class="toolbar">
      <select id="se-exam" class="input sm" aria-label="Examination">${opt(exams, 'id', (e) => `${e.name} - ${e.classes?.name || ''} (${e.term})${e.is_published ? ' - published' : ''}`)}</select>
      <select id="se-sub" class="input sm" aria-label="Subject"></select>
    </div>
    <div id="se-note"></div>
    <div class="card flush"><div id="se-body"></div></div>
    <div class="pager"><span class="muted" id="se-sum"></span><button class="btn primary" id="se-save">Save scores</button></div>`;
  const body = $('#se-body', view), save = $('#se-save', view), subSel = $('#se-sub', view), examSel = $('#se-exam', view);
  let exam, students = [];

  async function loadSubjects() {
    exam = exams.find((e) => e.id === examSel.value);
    let q = sb.from('teacher_assignments').select('subject_id, subjects(name,code)').eq('class_id', exam.class_id);
    if (!isAdmin && teacherId) q = q.eq('teacher_id', teacherId);
    const rows = await must(q);
    subSel.innerHTML = rows.length ? opt(rows, 'subject_id', (r) => r.subjects?.name) : '<option value="">No subjects assigned</option>';
    await loadScores();
  }
  async function loadScores() {
    body.innerHTML = loadingBlock();
    $('#se-note', view).innerHTML = '';
    if (!subSel.value) { body.innerHTML = emptyState('No subject to score', 'Assign a subject to this class first (Class subjects).', 'book'); save.disabled = true; return; }
    try {
      students = await must(sb.from('students').select('id,full_name,student_no').eq('class_id', exam.class_id).eq('status', 'active').order('full_name').limit(500));
      const res = await must(sb.from('exam_results').select('student_id,score,remarks').eq('exam_id', exam.id).eq('subject_id', subSel.value));
      const by = Object.fromEntries(res.map((r) => [r.student_id, r]));
      const locked = exam.is_published && !isAdmin;
      if (locked) $('#se-note', view).innerHTML = `<div class="notice">${icon('lock', 18)}<span>These results are published, so scores can no longer be changed. Ask an administrator for a correction.</span></div>`;
      save.disabled = locked || !students.length;
      if (!students.length) { body.innerHTML = emptyState('No students in this class', '', 'users'); return; }
      body.innerHTML = `<div class="table-wrap"><table class="table"><thead><tr><th>Student</th><th class="num">Score / ${num(exam.max_score)}</th><th>Grade</th><th>Remarks</th></tr></thead><tbody>${students.map((s) => `
        <tr data-id="${s.id}"><td><b>${esc(s.full_name)}</b><span class="sub">${esc(s.student_no)}</span></td>
        <td class="num"><input class="input score-input" type="number" min="0" max="${exam.max_score}" step="0.01" name="sc_${s.id}" value="${by[s.id]?.score ?? ''}" ${locked ? 'disabled' : ''} aria-label="Score for ${esc(s.full_name)}"></td>
        <td data-grade="${s.id}">${by[s.id] ? badge(gradeFor(pct(by[s.id].score, exam.max_score)).grade, 'info') : '-'}</td>
        <td><input class="input" name="rm_${s.id}" maxlength="120" value="${esc(by[s.id]?.remarks || '')}" ${locked ? 'disabled' : ''} placeholder="Optional"></td></tr>`).join('')}</tbody></table></div>`;
      updateCount();
    } catch (e) { body.innerHTML = errorBlock(e); }
  }
  const updateCount = () => { $('#se-sum', view).textContent = `${$$('input[name^=sc_]', body).filter((i) => i.value !== '').length} of ${students.length} scored`; };
  body.addEventListener('input', (e) => {
    if (!e.target.name?.startsWith('sc_')) return;
    const id = e.target.name.slice(3), cell = $(`[data-grade="${id}"]`, body);
    cell.innerHTML = e.target.value === '' ? '-' : badge(gradeFor(pct(e.target.value, exam.max_score)).grade, 'info');
    updateCount();
  });
  examSel.onchange = loadSubjects; subSel.onchange = loadScores;
  save.onclick = async () => {
    const rows = [];
    for (const s of students) {
      const input = $(`input[name="sc_${s.id}"]`, body);
      if (!input || input.value === '') continue;
      const score = Number(input.value);
      if (isNaN(score) || score < 0 || score > Number(exam.max_score)) { input.focus(); return toast(`Score for ${s.full_name} must be between 0 and ${exam.max_score}`, 'error'); }
      rows.push({ exam_id: exam.id, student_id: s.id, subject_id: subSel.value, score, remarks: ($(`input[name="rm_${s.id}"]`, body)?.value || '').trim() || null });
    }
    if (!rows.length) return toast('Enter at least one score', 'info');
    setBusy(save, true, 'Saving');
    try { await must(sb.from('exam_results').upsert(rows, { onConflict: 'exam_id,student_id,subject_id' })); toast(`${rows.length} score${rows.length === 1 ? '' : 's'} saved`); await loadScores(); }
    catch (e) { fail(e); } finally { setBusy(save, false); }
  };
  await loadSubjects();
}

/* =========================================================
   REPORT CARD
   ========================================================= */
export function reportCardHtml({ student, className, exam, yearName, rows, rank, classSize }) {
  const total = rows.reduce((a, r) => a + Number(r.score), 0);
  const maxTotal = rows.reduce((a, r) => a + Number(r.max), 0);
  const avg = maxTotal ? (total / maxTotal) * 100 : 0;
  const overall = gradeFor(avg);
  return `<div class="paper print-area">
    <header><span class="logo">${LOGO}</span><div><h2>${esc(CONFIG.SCHOOL.name)}</h2><small>${esc(CONFIG.SCHOOL.motto)} | Student Report Card</small></div></header>
    <div class="meta">
      <span><b>Student:</b> ${esc(student.full_name)}</span><span><b>Student no:</b> ${esc(student.student_no)}</span>
      <span><b>Class:</b> ${esc(className || '-')}</span><span><b>Academic year:</b> ${esc(yearName || '-')}</span>
      <span><b>Examination:</b> ${esc(exam.name)}</span><span><b>Term:</b> ${esc(exam.term)}</span>
    </div>
    <table><thead><tr><th>Subject</th><th class="num">Score</th><th class="num">Out of</th><th class="num">%</th><th>Grade</th><th>Remark</th></tr></thead><tbody>
      ${rows.map((r) => { const p = pct(r.score, r.max); return `<tr><td>${esc(r.subject)}</td><td class="num">${num(r.score, 2)}</td><td class="num">${num(r.max)}</td><td class="num">${num(p)}</td><td><b>${esc(r.grade || gradeFor(p).grade)}</b></td><td>${esc(r.remarks || gradeFor(p).remark)}</td></tr>`; }).join('')}
    </tbody><tfoot><tr><th>Total</th><th class="num">${num(total, 2)}</th><th class="num">${num(maxTotal)}</th><th class="num">${num(avg)}</th><th>${overall.grade}</th><th>${overall.remark}</th></tr></tfoot></table>
    <div class="meta" style="margin-top:14px"><span><b>Average:</b> ${num(avg, 1)}%</span><span><b>Overall grade:</b> ${overall.grade} (${overall.remark})</span>
      ${rank ? `<span><b>Position in class:</b> ${rank} of ${classSize}</span>` : ''}<span><b>Subjects:</b> ${rows.length}</span></div>
    <div class="sign"><span>Class teacher</span><span>Head teacher</span><span>Parent / guardian</span></div>
  </div>`;
}

// Load everything needed for one student's report card for one exam
export async function loadReportCard(examId, studentId, { withRank = false } = {}) {
  const [exam, student] = await Promise.all([
    must(sb.from('examinations').select('*, academic_years(name), classes(name)').eq('id', examId).single()),
    must(sb.from('students').select('id,full_name,student_no').eq('id', studentId).single()),
  ]);
  const res = await must(sb.from('exam_results').select('student_id,subject_id,score,grade,remarks, subjects(name)').eq('exam_id', examId).limit(5000));
  const mine = res.filter((r) => r.student_id === studentId).map((r) => ({ subject: r.subjects?.name, score: r.score, max: exam.max_score, grade: r.grade, remarks: r.remarks }))
    .sort((a, b) => String(a.subject).localeCompare(String(b.subject)));
  let rank = null, classSize = null;
  if (withRank) {
    const totals = {};
    res.forEach((r) => { totals[r.student_id] = (totals[r.student_id] || 0) + Number(r.score); });
    const sorted = Object.values(totals).sort((a, b) => b - a);
    classSize = sorted.length; rank = sorted.indexOf(totals[studentId]) + 1 || null;
  }
  return { html: reportCardHtml({ student, className: exam.classes?.name, exam, yearName: exam.academic_years?.name, rows: mine, rank, classSize }), empty: !mine.length };
}

export function showPrintable(title, html) {
  const m = modal({ title, size: 'lg', html, footer: `<button class="btn ghost" data-close>Close</button><button class="btn primary" id="do-print">${icon('printer', 16)} Print / Save as PDF</button>` });
  $('#do-print', m.el).onclick = () => window.print();
  return m;
}

